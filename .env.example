# Copy to .env.local and fill in. Never commit .env.local.
# Both values are in the Supabase dashboard: Project Settings -> API (or "API Keys").
# These two are safe to ship to the browser; row-level security protects the data.
# Use the "publishable" key (older projects: the "anon" key). Never the secret / service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-side only (never NEXT_PUBLIC, never commit real values) ---
# Web Push keys: generate a pair with  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase SECRET key, used only by the scheduled reminder job.
SUPABASE_SECRET_KEY=
# Shared secret the Supabase scheduled job sends when it calls /api/cron/reminders.
CRON_SECRET=
# Only for the local reader test (npm run test:reader). The app uses the key saved on the device.
GEMINI_API_KEY=
